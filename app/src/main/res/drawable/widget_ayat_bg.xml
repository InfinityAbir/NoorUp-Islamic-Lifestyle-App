<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphic card: translucent emerald-to-navy gradient with a soft light edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:startColor="#E6064E3B"
        android:endColor="#E60F172A"
        android:angle="315" />
    <stroke
        android:width="1dp"
        android:color="#6634D399" />
</shape>
