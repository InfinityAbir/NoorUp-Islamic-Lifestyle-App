<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ayat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_ayat_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ayat_kind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Verse of the Day"
            android:textColor="#34D399"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/ayat_ref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2:255"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/ayat_arabic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="19sp"
        android:autoSizeStepGranularity="1sp"
        android:lineSpacingMultiplier="1.1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/ayat_translation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:gravity="center_horizontal"
        android:text="আল্লাহ, তিনি ছাড়া কোনো উপাস্য নেই"
        android:textColor="#E2E8F0"
        android:textSize="12.5sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="13sp"
        android:autoSizeStepGranularity="0.5sp"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ayat_btn_refresh"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_ayat_btn_bg"
            android:text="⟳ Refresh"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/ayat_btn_bookmark"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/widget_ayat_btn_bg"
            android:text="☆ Save"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/ayat_btn_open"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/widget_ayat_btn_bg"
            android:text="Open ›"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
