<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <!-- Top Header: Brand Name (Left), Dates (Center), City (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_brand_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NoorUp"
            android:textColor="#34D399"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_hijri_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="১৩ রবিউস সানি ১৪৪৮ হিজরি"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_gregorian_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 September 2026"
                android:textColor="#9CA3AF"
                android:textSize="9.5sp"
            android:maxLines="1"
            android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="উত্তরা, ঢাকা"
            android:textColor="#A7F3D0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Main Content Row: two-column hero + timeline.
         Responsive: wrap_content height so both cards size to their content.
         The previous 0dp/weight=1 fixed-height row forced the hero's upper
         section into a short box; the countdown line then sat exactly on the
         divider/garden boundary and was overlapped/clipped in English. With
         wrap_content + baselineAligned=false each card grows naturally and the
         countdown stays in normal flow, fully visible in both languages. -->
    <LinearLayout
        android:id="@+id/widget_content_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left Column: Active Prayer Hero Card + Integrated Garden Progress.
             Responsive: wrap_content height (was match_parent inside a fixed
             0dp-weight row). Content-driven so the card expands for long
             English labels/windows/countdowns instead of clipping them. -->
        <LinearLayout
            android:id="@+id/widget_hero_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_hero_card_bg"
            android:padding="8dp">

            <!-- Active Prayer Info Section: content-driven (was 0dp/weight=1 with
                 center_vertical, which clipped the 4th line). All four lines now
                 contribute to the card's natural height in normal flow. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_active_stage_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="চলমান ওয়াক্ত"
                    android:textColor="#34D399"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_active_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="আসর"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_active_window"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="04:22 PM – 05:32 PM"
                    android:textColor="#E5E7EB"
                    android:textSize="10.5sp"
                    android:lineSpacingExtra="1dp" />

                <TextView
                    android:id="@+id/widget_active_countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:paddingBottom="2dp"
                    android:text="বাকি ১ ঘ. ১৫ মি."
                    android:textColor="#FDE68A"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="1dp" />
            </LinearLayout>

            <!-- Subtle Inner Divider using FrameLayout (fully supported by RemoteViews) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="#1E293B" />

            <!-- Noor Garden Habit Progress Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_garden_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌱 নূর বাগান"
                        android:textColor="#A7F3D0"
                        android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_garden_ratio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="৩/৫"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/widget_garden_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:max="5"
                    android:progress="3"
                    android:progressDrawable="@drawable/widget_progress_bg" />

                <TextView
                    android:id="@+id/widget_garden_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 ৭ দিন স্ট্রিক • ৬০%"
                    android:textColor="#D1FAE5"
                    android:textSize="9sp"
            android:maxLines="1"
            android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Column: 5 Daily Prayer Rows. Content-driven rows with even
             padding so rows stay uniform and compact, and grow under larger
             font scaling instead of clipping. Prayer names flex (weight=1)
             while time ranges stay single-line readout. No fixed heights. -->
        <LinearLayout
            android:id="@+id/widget_timeline_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:background="@drawable/widget_timeline_card_bg"
            android:padding="6dp">

            <!-- Fajr Row -->
            <LinearLayout
                android:id="@+id/widget_fajr_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/widget_fajr_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ফজর"
                    android:textColor="#E5E7EB"
                    android:textSize="10.5sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_fajr_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৪:৪৮"
                    android:textColor="#E5E7EB"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" – "
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_fajr_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৫:৫৮ AM"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
            </LinearLayout>

            <!-- Dhuhr Row -->
            <LinearLayout
                android:id="@+id/widget_dhuhr_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/widget_dhuhr_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="যোহর"
                    android:textColor="#E5E7EB"
                    android:textSize="10.5sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_dhuhr_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="১২:০৫"
                    android:textColor="#E5E7EB"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" – "
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_dhuhr_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৪:২১ PM"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
            </LinearLayout>

            <!-- Asr Row -->
            <LinearLayout
                android:id="@+id/widget_asr_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/widget_asr_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="আসর"
                    android:textColor="#34D399"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_asr_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৪:২২"
                    android:textColor="#34D399"
                    android:textSize="10sp"
                    android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" – "
                    android:textColor="#34D399"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_asr_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৫:৩২ PM"
                    android:textColor="#6EE7B7"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
            </LinearLayout>

            <!-- Maghrib Row -->
            <LinearLayout
                android:id="@+id/widget_maghrib_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/widget_maghrib_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="মাগরিব"
                    android:textColor="#E5E7EB"
                    android:textSize="10.5sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_maghrib_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৬:১৮"
                    android:textColor="#E5E7EB"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" – "
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_maghrib_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৭:৩২ PM"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
            </LinearLayout>

            <!-- Isha Row -->
            <LinearLayout
                android:id="@+id/widget_isha_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/widget_isha_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="এশা"
                    android:textColor="#E5E7EB"
                    android:textSize="10.5sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_isha_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৭:৩৩"
                    android:textColor="#E5E7EB"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" – "
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_isha_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৪:৪৭ AM"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Footer Bar: 3 Prohibited / Makruh Times.
         Responsive: vertical two-line layout (yellow label on its own line +
         one times line that wraps naturally). The times line uses wrap_content
         height with NO maxLines/ellipsize cap, so sunrise/zawal/sunset ranges
         stay complete: compact single line on wide widgets, two+ lines on
         narrow widgets or larger fonts. Ranges use "–" without inner spaces so
         each range stays together; wrapping happens at the " • " separators. -->
    <LinearLayout
        android:id="@+id/widget_prohibited_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:background="@drawable/widget_timeline_card_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/widget_prohibited_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ ৩টি নিষিদ্ধ সময়:"
            android:textColor="#FBBF24"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_prohibited_times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="সূর্যোদয়: ০৫:৫৮–০৬:১৪ • দ্বিপ্রহর: ১১:৫০–১২:০৪ • সূর্যাস্ত: ০৬:০০–০৬:১৭"
            android:textColor="#E5E7EB"
            android:textSize="9sp"
            android:lineSpacingExtra="1dp" />
    </LinearLayout>
</LinearLayout>
