<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Top Bar: Brand, Dates, City -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_brand_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NoorUp"
            android:textColor="#34D399"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_hijri_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="১৩ রবিউস সানি ১৪৪৮ হিজরি"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_gregorian_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 September 2026"
                android:textColor="#9CA3AF"
                android:textSize="9.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="উত্তরা, ঢাকা"
            android:textColor="#A7F3D0"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Main Content Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Left Active Hero Card -->
        <LinearLayout
            android:id="@+id/widget_hero_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_hero_card_bg"
            android:padding="8dp">

            <TextView
                android:id="@+id/widget_active_stage_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="চলমান ওয়াক্ত"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_active_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আসর"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_active_window"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04:22 PM – 06:17 PM"
                android:textColor="#E5E7EB"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_active_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="বাকি ১ ঘ. ১৫ মি."
                android:textColor="#FDE68A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_garden_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌱 নূর বাগান"
                        android:textColor="#A7F3D0"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/widget_garden_ratio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="৩/৫"
                        android:textColor="#FFFFFF"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/widget_garden_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="5"
                    android:progress="3" />

                <TextView
                    android:id="@+id/widget_garden_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 ৭ দিন স্ট্রিক • ৬০%"
                    android:textColor="#D1FAE5"
                    android:textSize="8.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right 5 Prayers Timeline List -->
        <LinearLayout
            android:id="@+id/widget_timeline_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:background="@drawable/widget_timeline_card_bg"
            android:padding="6dp">

            <!-- Fajr Row -->
            <LinearLayout
                android:id="@+id/widget_fajr_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="1dp">

                <TextView
                    android:id="@+id/widget_fajr_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ফজর"
                    android:textColor="#E5E7EB"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_fajr_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৪:৪৮"
                    android:textColor="#E5E7EB"
                    android:textSize="9.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" – "
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/widget_fajr_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৫:৫৮ AM"
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Dhuhr Row -->
            <LinearLayout
                android:id="@+id/widget_dhuhr_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="1dp">

                <TextView
                    android:id="@+id/widget_dhuhr_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="যোহর"
                    android:textColor="#E5E7EB"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_dhuhr_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="১২:০৫"
                    android:textColor="#E5E7EB"
                    android:textSize="9.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" – "
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/widget_dhuhr_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৪:২১ PM"
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Asr Row -->
            <LinearLayout
                android:id="@+id/widget_asr_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="1dp">

                <TextView
                    android:id="@+id/widget_asr_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="আসর"
                    android:textColor="#34D399"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_asr_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৪:২২"
                    android:textColor="#34D399"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" – "
                    android:textColor="#34D399"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/widget_asr_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৬:১৭ PM"
                    android:textColor="#6EE7B7"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Maghrib Row -->
            <LinearLayout
                android:id="@+id/widget_maghrib_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="1dp">

                <TextView
                    android:id="@+id/widget_maghrib_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="মাগরিব"
                    android:textColor="#E5E7EB"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_maghrib_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৬:১৮"
                    android:textColor="#E5E7EB"
                    android:textSize="9.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" – "
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/widget_maghrib_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৭:৩২ PM"
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Isha Row -->
            <LinearLayout
                android:id="@+id/widget_isha_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="1dp">

                <TextView
                    android:id="@+id/widget_isha_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="এশা"
                    android:textColor="#E5E7EB"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_isha_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৭:৩৩"
                    android:textColor="#E5E7EB"
                    android:textSize="9.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" – "
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/widget_isha_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="০৪:৪৭ AM"
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
