<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tasbih_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_ayat_bg"
    android:padding="10dp">

    <!-- ‹ zikr name ›  : change the zikr without opening the app -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tasbih_btn_prev"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:background="@drawable/widget_ayat_btn_bg"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tasbih_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Subhanallah"
            android:textColor="#34D399"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tasbih_btn_next"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:background="@drawable/widget_ayat_btn_bg"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tasbih_count_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tasbih_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tasbih_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="/ 33"
                android:textColor="#94A3B8"
                android:textSize="15sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tasbih_stage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginEnd="70dp"
            android:text=""
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tasbih_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:text="Today 0"
            android:textColor="#CBD5E1"
            android:textSize="10.5sp"
            android:maxLines="1" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/tasbih_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/widget_tasbih_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tasbih_btn_reset"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_ayat_btn_bg"
            android:text="Reset"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tasbih_btn_tap"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="2"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/widget_tasbih_tap_bg"
            android:text="+ Count"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tasbih_btn_open"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/widget_ayat_btn_bg"
            android:text="Open ›"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
